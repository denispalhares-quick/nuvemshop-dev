{
  "name": "nuvemshop-dev-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build de CSS (Tailwind) e JS (esbuild + Alpine) para o tema Nuvemshop",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/css/main.css -o ../theme/static/css/style.css --minify",
    "build:js": "node build.mjs",
    "dev": "node build.mjs --watch & tailwindcss -i src/css/main.css -o ../theme/static/css/style.css --watch",
    "clean": "rm -f ../theme/static/css/style.css ../theme/static/js/store.js"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.2",
    "alpinejs": "^3.17.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
