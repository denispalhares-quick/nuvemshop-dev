# ---- Nuvemshop Admin API (app criado em partners.nuvemshop.com.br) ----
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_STORE_ID=
TIENDANUBE_BASE_URL=https://api.nuvemshop.com.br/2025-03
TIENDANUBE_USER_AGENT=nuvemshop-dev-mcp (denis.palhares22@gmail.com)

# ---- Nuvemshop CLI (tema) ----
# Local: rode `nuvemshop theme authorize` uma vez. Em CI use o token abaixo.
NUVEMSHOP_CLI_TOKEN=
THEME_DIR=./theme

# IDs das instalacoes de tema (nuvemshop theme list)
THEME_ID_HOMOLOG=
THEME_ID_PROD=

# ---- Transporte do MCP ----
MCP_TRANSPORT=stdio          # stdio | streamable-http | sse
MCP_HOST=0.0.0.0
MCP_PORT=8080
