{
	"compilerOptions": {
		"target": "es2020",
		"jsx": "react-jsx",
		"jsxImportSource": "@tiendanube/nube-sdk-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["./src/**/*"]
}
