{
	"name": "nube-frete-gratis",
	"version": "0.1.0",
	"private": true,
	"description": "App NubeSDK: barra de progresso de frete grátis no checkout (identidade Quick Digital)",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n BUILD,SERVE -c blue,green \"tsup --sourcemap inline --watch\" \"serve dist -l 8080 --cors\"",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@tiendanube/nube-sdk-jsx": "^0.22.0",
		"@tiendanube/nube-sdk-types": "^0.100.0",
		"concurrently": "^9.1.2",
		"serve": "^14.2.4",
		"tsup": "^8.3.0",
		"typescript": "^5.6.2",
		"vitest": "^3.2.4"
	}
}
